{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -- --configuration production",
  "outputDirectory": "dist/nais_frontend/browser",
  "rewrites": [
    { "source": "/home", "destination": "/index.html" },
    { "source": "/products", "destination": "/index.html" },
    { "source": "/products/:slug", "destination": "/index.html" },
    { "source": "/shop", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
