{
  "name": "nais-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:promo": "node --test server/promo-signup.test.mjs",
    "test:webhook": "node --test server/stripe-webhook.test.mjs",
    "test:orders": "node --test server/order-lookup.test.mjs",
    "check:server": "tsc -p server/tsconfig.json",
    "d1:local:migrate": "npx wrangler d1 migrations apply PROMO_DB --local",
    "d1:local:tables": "npx wrangler d1 execute PROMO_DB --local --command \"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name;\"",
    "test:checkout": "node --test server/checkout-infrastructure.test.mjs server/checkout-validation.test.mjs server/checkout-session.test.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "rxjs": "~7.8.0",
    "stripe": "^22.6.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
