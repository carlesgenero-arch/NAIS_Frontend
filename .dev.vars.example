# Local Pages Functions bindings only. Copy to .dev.vars (gitignored).
# Replace placeholders with TEST-mode values. Never copy these into Angular.
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_TEST_SECRET
# Existing valid 10% coupon in the same Stripe mode/account as the secret key.
STRIPE_PROMO_COUPON_ID=REPLACE_WITH_EXISTING_10_PERCENT_COUPON_ID
STRIPE_PRICE_ORANGE_SPRITZ=REPLACE_WITH_TEST_PRICE_ID
STRIPE_PRICE_PASSION_HUGO=REPLACE_WITH_TEST_PRICE_ID
STRIPE_PRICE_GINGER_CRUSH=REPLACE_WITH_TEST_PRICE_ID
STRIPE_PRICE_TROPICAL_HOPS=REPLACE_WITH_TEST_PRICE_ID
STRIPE_PRICE_PACK_VARIAT=REPLACE_WITH_TEST_PRICE_ID
SITE_URL=http://localhost:4200
# Endpoint signing secret (Stripe CLI and deployed endpoint use different values).
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
